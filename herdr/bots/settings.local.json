      "Bash(gh api:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr approve:*)",
      "Bash(glab mr note:*)",
      "Bash(glab mr update:*)",
      "Bash(glab api -X:*)",
      "Bash(glab api --method:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(kubectl:*)",
      "Bash(mysql:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
