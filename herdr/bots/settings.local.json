{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree add:*)",
      "Bash(hc run:*)",
      "Bash(hc send:*)",
      "Bash(~/.herdr-bots/bin/herdr-bot dm:*)"
