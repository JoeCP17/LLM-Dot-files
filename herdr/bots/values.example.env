# herdr-bots 봇 템플릿(profiles/*/SOUL.md, settings.extra.json)에 채울 값의 예시
# 이 파일을 ~/.config/herdr-bots/values.env 로 복사해 실제 값으로 바꾼다. 실제 값은 레포에 넣지 않는다.
TEAM_SCOPE='우리 팀 백엔드'
DATADOG_MAP_DOC='/path/to/vault/datadog-operations.md'
WEEKLY_DIR='/path/to/vault/daily-work'
GITLAB_HOST='gitlab.example.com'
GITLAB_USER='my-gitlab-id'
JIRA_BASE_URL='https://example.atlassian.net'
CONFLUENCE_SPACE='SPACEKEY'
JIRA_FIELD_DEV_START='customfield_00000'
JIRA_FIELD_DEV_END='customfield_00000'
OWNER_NAME='홍길동'
ONCALL_ROW='On-call'
