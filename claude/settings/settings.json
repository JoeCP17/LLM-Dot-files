{
  "env": {
    "ECC_GATEGUARD": "off",
    "ECC_DISABLED_HOOKS": "post:ecc-context-monitor"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "db=~/.hedwig-cg/dbs/$(basename $(git rev-parse --show-toplevel 2>/dev/null || pwd))/knowledge.db; [ -f \"$db\" ] && hedwig-cg-auto update >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/md-rule-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "anthropic-agent-skills@anthropic-agent-skills": true,
    "jdtls@claude-code-lsps": true,
    "everything-claude-code@everything-claude-code": true,
    "msbaek-tdd@msbaek-claude-plugins": false,
    "bo@ktown4u-plugins": false,
    "jdtls-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "ecc@ecc": true,
    "kotlin-lsp@claude-code-lsps": true,
    "kotlin-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "everything-claude-code": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    },
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/everything-claude-code"
      }
    },
    "ktown4u-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/ktown4u/ktown4u-plugins.git"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
